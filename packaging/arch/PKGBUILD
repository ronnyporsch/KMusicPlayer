# Builds the desktop app from the committed HEAD of the repository this PKGBUILD lives in.
# Usage: cd packaging/arch && makepkg -si
pkgname=kmusicplayer
pkgver=1.0.0.r3.gdf3360f
pkgrel=1
pkgdesc='Music player for Jellyfin and Subsonic/Navidrome servers'
arch=('x86_64' 'aarch64')
url='https://github.com/ronnyporsch/KMusicPlayer'
license=('custom')
depends=('java-runtime>=21' 'hicolor-icon-theme')
makedepends=('git')
optdepends=('vlc: YouTube video playback')
options=('!debug')
source=("$pkgname::git+file://${startdir%/packaging/arch}"
        'kmusicplayer.desktop'
        'kmusicplayer.sh')
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

pkgver() {
    cd "$pkgname"
    local tag
    tag=$(git describe --tags --match 'v[0-9]*' --abbrev=0 2>/dev/null || echo v1.0.0)
    printf '%s.r%s.g%s' "${tag#v}" "$(git rev-list --count "$tag"..HEAD 2>/dev/null || echo 0)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$pkgname"
    ./gradlew --no-daemon :desktopApp:packageUberJarForCurrentOS
}

package() {
    cd "$pkgname"
    install -Dm644 desktopApp/build/compose/jars/de.ronnyporsch.kmusicplayer-linux-*.jar \
        "$pkgdir/usr/share/java/$pkgname/$pkgname.jar"
    install -Dm755 "$srcdir/kmusicplayer.sh" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "$srcdir/kmusicplayer.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
    install -Dm644 desktopApp/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
}
